# Lab 04: Savings Goal Planner
# Demonstrating: while loops for validation, for-range simulation, accumulators, and early break.

# --- 1. Input Collection & Validation (while döngüleri ile) ---
starting_balance = float(input("Enter starting balance: "))
while starting_balance < 0:
    print("Starting balance cannot be negative.")
    starting_balance = float(input("Enter starting balance: "))

monthly_deposit = float(input("Enter monthly deposit: "))
while monthly_deposit <= 0:
    print("Enter a positive monthly deposit.")
    monthly_deposit = float(input("Enter monthly deposit: "))

interest_rate = float(input("Enter monthly interest rate (%): "))
while interest_rate < 0:
    print("Interest rate cannot be negative.")
    interest_rate = float(input("Enter monthly interest rate (%): "))

savings_goal = float(input("Enter savings goal: "))
while savings_goal <= 0:
    print("Savings goal must be greater than zero.")
    savings_goal = float(input("Enter savings goal: "))

print()

# --- 2. Edge Case Check ---
# Başlangıç bakiyesi zaten hedefe ulaşıyorsa tablo basmadan sonlandır
if starting_balance >= savings_goal:
    print("Starting balance already meets or exceeds the savings goal.")
    print("Goal reached: Yes (in 0 months)")
    print(f"Final balance: {starting_balance:.2f} TRY")
    print("Total interest earned: 0.00 TRY")

else:
    # --- 3. Simulation & Accumulator Setup ---
    balance = starting_balance
    total_interest = 0.0
    months_passed = 0
    goal_reached = False

    # Hizalı tablo başlığı
    print(f"{'Month':>5} | {'Interest':>10} | {'Balance':>12}")
    print("-" * 33)

    # 60 aylık simülasyon (for range & break)
    for month in range(1, 61):
        months_passed = month

        # 1. Önce mevcut bakiye üzerinden faiz hesapla
        month_interest = balance * (interest_rate / 100.0)
        total_interest += month_interest

        # 2. Faizi ve aylık birikimi bakiyeye ekle
        balance += month_interest + monthly_deposit

        # Tablo satırını biçimlendirerek yazdır (örnekteki format kalıbı)
        print(f"{month:5d} | {month_interest:10.2f} | {balance:12.2f}")

        # Hedefe ulaşıldıysa döngüyü erken bitir (break)
        if balance >= savings_goal:
            goal_reached = True
            break

    print("-" * 33)

    # --- 4. Final Summary ---
    if goal_reached:
        print(f"Goal reached in {months_passed} month(s)!")
    else:
        print(f"Goal not reached within {months_passed} months.")

    print(f"Final balance: {balance:.2f} TRY")
    print(f"Total interest earned: {total_interest:.2f} TRY")

